# Used only by the PHP processes that the Concurrency test suite spawns with
# `APP_ENV=testing` (see tests/Support/ConcurrentServer.php). Laravel loads
# this file instead of .env whenever APP_ENV=testing is already set in the
# process environment before boot. Must point at the same database as
# phpunit.xml so spawned servers and the test runner see one committed state.
APP_NAME="Foodics Inventory (testing)"
APP_ENV=testing
APP_KEY=base64:oVOPmPFFuB5zJcfa4byfGGotal/2bmauKhkJFV0wuUk=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8089

DB_CONNECTION=pgsql
DB_HOST=postgres_test
DB_PORT=5432
DB_DATABASE=foodics_test
DB_USERNAME=foodics
DB_PASSWORD=foodics

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
MAIL_MAILER=array
BCRYPT_ROUNDS=4
LOG_CHANNEL=stack
LOG_LEVEL=error
